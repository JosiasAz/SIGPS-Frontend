# SIGPS Frontend — variáveis (referência)

# Produção (Vercel): definido em src/app/env/environment.ts
#   apiUrl = https://api.sigps.online
#   useMock = false

# Desenvolvimento local: src/app/env/environment.development.ts
#   apiUrl = http://127.0.0.1:5000

# Não é necessário .env na Vercel — o build de produção usa environment.ts.
